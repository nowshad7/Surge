#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Surge CLI.
 *
 * Usage:
 *   surge serve [--host=0.0.0.0] [--port=9019] [--handler=broadcast]
 *
 * Loads Composer's autoloader when installed as a dependency, otherwise falls
 * back to the bundled standalone autoloader so `php bin/surge` just works.
 */

use Nsd7\Surge\Handler\BroadcastHandler;
use Nsd7\Surge\Http\PusherHttpApi;
use Nsd7\Surge\Pusher\PusherProtocol;
use Nsd7\Surge\Pusher\Signature;
use Nsd7\Surge\Runtime\SwooleRuntime;
use Nsd7\Surge\Support\Logger;
use Nsd7\Surge\Surge;

(static function (array $argv): void {
    $autoloaders = [
        __DIR__ . '/../vendor/autoload.php',   // installed as a dependency
        __DIR__ . '/../../../autoload.php',     // inside someone's vendor/
        __DIR__ . '/../autoload.php',           // running from a clone
    ];
    foreach ($autoloaders as $file) {
        if (is_file($file)) {
            require $file;
            break;
        }
    }

    $args = array_slice($argv, 1);
    $command = $args[0] ?? 'serve';

    $options = [];
    foreach ($args as $arg) {
        if (preg_match('/^--([a-z0-9\-]+)=(.*)$/', $arg, $m) === 1) {
            $options[$m[1]] = $m[2];
        }
    }

    if ($command !== 'serve') {
        fwrite(STDERR, "Unknown command '{$command}'. Usage: surge serve [--host=] [--port=] [--handler=broadcast]\n");
        exit(64);
    }

    $env = static fn (string $key, ?string $default = null): ?string => getenv($key) !== false ? getenv($key) : $default;

    $host = $options['host'] ?? $env('SURGE_HOST', '0.0.0.0');
    $port = (int) ($options['port'] ?? $env('SURGE_PORT', '9019'));
    $mode = $options['handler'] ?? $env('SURGE_HANDLER', 'pusher');

    $logFormat = $env('SURGE_LOG_FORMAT', 'text') === 'json' ? Logger::JSON : Logger::TEXT;
    $logger = (new Logger($logFormat))->asCallable();

    if ($mode === 'broadcast') {
        $server = new Surge(new BroadcastHandler(), logger: $logger);
        $logger("Starting Surge (broadcast relay) on ws://{$host}:{$port}");
    } else {
        $appId  = $options['app-id'] ?? $env('SURGE_APP_ID', 'surge');
        $key    = $options['key']    ?? $env('SURGE_APP_KEY', 'surge-key');
        $secret = $options['secret'] ?? $env('SURGE_APP_SECRET', 'surge-secret');

        $signature = new Signature($key, $secret);
        $protocol  = new PusherProtocol($signature);
        $httpApi   = new PusherHttpApi($signature, $protocol, $appId);

        // Runtime selection: lite (default, pure PHP) or turbo (OpenSwoole).
        $runtimeName = $options['runtime'] ?? $env('SURGE_RUNTIME', 'lite');
        $runtime = $runtimeName === 'turbo'
            ? new SwooleRuntime($protocol, $httpApi, 0, $logger)
            : null;

        $server = new Surge($protocol, $runtime, $logger, $httpApi);
        $logger("Starting Surge (Pusher-compatible, {$runtimeName} runtime) app '{$appId}' on ws://{$host}:{$port}");
    }

    if (function_exists('pcntl_signal')) {
        pcntl_async_signals(true);
        $stop = static function () use ($server, $logger): void {
            $logger('Shutting down...');
            $server->stop();
        };
        pcntl_signal(SIGINT, $stop);
        pcntl_signal(SIGTERM, $stop);
    }

    $server->run($host, $port);
})($argv);
