{
    "name": "nsd7/surge",
    "description": "Surge — a lightweight, self-hosted, Pusher-compatible realtime broadcasting server for Laravel. No required dependencies.",
    "type": "library",
    "keywords": ["websocket", "realtime", "broadcasting", "laravel", "pusher", "echo", "server", "presence", "redis"],
    "license": "MIT",
    "homepage": "https://nowshad7.github.io/Surge/",
    "authors": [
        {
            "name": "nowshad7",
            "homepage": "https://github.com/nowshad7",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/nowshad7/Surge/issues",
        "source": "https://github.com/nowshad7/Surge",
        "docs": "https://nowshad7.github.io/Surge/"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-sockets": "*"
    },
    "suggest": {
        "ext-redis": "Enables the Redis scaling adapter for running Surge across multiple nodes.",
        "ext-openswoole": "Enables the high-performance multi-core Turbo runtime.",
        "illuminate/support": "Required only to use the Laravel integration (service provider and surge:serve command)."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nsd7\\Surge\\Laravel\\SurgeServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Nsd7\\Surge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nsd7\\Surge\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/surge"],
    "scripts": {
        "test": "php tests/run.php"
    }
}
